// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// SQLite keeps local development zero-setup: `npm run db:push` creates the file for you.
// Prisma does not allow env() in `provider`, so switching to a hosted database is a manual
// one-line edit here (`mysql` or `postgresql`) plus a matching DATABASE_URL. The model below
// uses no provider-specific types, so it ports across all three unchanged.
datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Post {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  content   String
  authorId  String

  @@index([authorId])
}

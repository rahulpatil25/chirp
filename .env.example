# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.mjs"
# should be updated accordingly.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Defaults to a local SQLite file. Run `npm run db:push` once to create it.
# To use a hosted database instead, change the `provider` in
# prisma/schema.prisma and the driver adapter in src/server/db.ts to match.
DATABASE_URL="file:./prisma/dev.db"

# ---------------------------------------------------------------------------
# Clerk authentication (required)
# ---------------------------------------------------------------------------
# Create a free application at https://dashboard.clerk.com and copy both keys
# from "API Keys". Enable the "Username" attribute — Chirp addresses users by
# username, and profile pages 404 for accounts that do not have one.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Upstash Redis rate limiting (optional)
# ---------------------------------------------------------------------------
# Leave both blank for local development and the app falls back to an in-memory
# rate limiter. Set both in any deployment that runs more than one instance,
# since in-memory state is not shared between them.
# Create a database at https://console.upstash.com to get these values.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
